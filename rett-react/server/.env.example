# Server-side env vars. NEVER commit a real .env to git.
#
# Get a key at https://aistudio.google.com/apikey. The proxy sends the key
# to generativelanguage.googleapis.com and never returns it to the browser.
GEMINI_API_KEY=replace-me

# Default model. Can be overridden per-request by the React client via the
# `model` form field on /api/gemini/extract-w2.
GEMINI_MODEL=gemini-2.5-flash

# Port the proxy listens on. Vite's dev server proxies /api/* to this in
# development. Nginx forwards /api/* to this in production (see DEPLOYMENT.md).
PORT=8787

# Comma-separated origins allowed to call /api/* (used in production behind
# Nginx; left wide-open in dev because Vite proxies same-origin).
ALLOWED_ORIGINS=*

# Per-IP rate limit on /api/gemini/extract-w2. 30 requests per 10 minutes is
# enough for normal advisor use and blunts the cost of any leaked endpoint.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30
