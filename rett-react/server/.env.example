# Server-side env vars. NEVER commit a real .env to git — this repo is PUBLIC,
# so a real value here would leak to the whole internet. Copy this file to
# `.env` (same directory) and fill in real values there:  cp .env.example .env
# Share real secrets out-of-band (Neon dashboard / password manager), not git.

# --- Neon Postgres: saved RETT flows (auto-save + Saved Flows history) ------
# REQUIRED for the database feature. Without it /api/flows returns 503 and
# nothing saves to the cloud (the app still runs on localStorage only). Get the
# connection string from the Neon dashboard (Project → Connect, pooled host) or
# from whoever set up the database. Keep the sslmode/channel_binding args.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require&channel_binding=require

# --- Gemini: optional W-2 / 1040 autofill proxy ----------------------------
# Get a key at https://aistudio.google.com/apikey. The proxy sends the key
# to generativelanguage.googleapis.com and never returns it to the browser.
# Leave blank to disable the "Upload 1040 to autofill" button.
GEMINI_API_KEY=replace-me

# Default model. Can be overridden per-request by the React client via the
# `model` form field on /api/gemini/extract-w2.
GEMINI_MODEL=gemini-2.5-flash

# Port the proxy listens on. Vite's dev server proxies /api/* to this in
# development. Nginx forwards /api/* to this in production (see DEPLOYMENT.md).
PORT=8787

# Comma-separated origins allowed to call /api/* (used in production behind
# Nginx; left wide-open in dev because Vite proxies same-origin).
ALLOWED_ORIGINS=*

# Per-IP rate limit on /api/gemini/extract-w2. 30 requests per 10 minutes is
# enough for normal advisor use and blunts the cost of any leaked endpoint.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30
