# Front-end env vars. Anything prefixed VITE_ is shipped to the browser, so
# NEVER put secrets here. The Gemini API key lives in server/.env.

# Where the W-2 uploader sends extraction requests.
#   server  - default. Calls our Express proxy at /api/gemini/extract-w2.
#             The Gemini key stays server-side. Use this for production.
#   client  - legacy fallback. The user types their own Gemini key into the
#             form; the browser calls Google directly. Internal-only.
VITE_GEMINI_MODE=server

# Port the Express proxy listens on (vite proxies /api -> this port in dev).
VITE_API_PORT=8787

# The Gemini model the proxy / browser uses for tax-doc extraction.
# Upstream uses gemini-2.0-flash; we default to 2.5-flash for better accuracy
# but the proxy accepts either.
VITE_GEMINI_MODEL=gemini-2.5-flash
